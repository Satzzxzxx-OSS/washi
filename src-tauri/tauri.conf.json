{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Washi",
  "version": "1.0.0",
  "identifier": "dev.kiwamizamurai.washi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Washi",
        "width": 900,
        "height": 1000,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "worker-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Viewer and editor for Markdown, Typst, LaTeX, Mermaid and PDF",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["md", "markdown", "mdown"], "name": "Markdown", "role": "Viewer" },
      { "ext": ["typ"], "name": "Typst", "role": "Viewer" },
      { "ext": ["tex", "latex"], "name": "LaTeX", "role": "Viewer" },
      { "ext": ["mmd", "mermaid"], "name": "Mermaid", "role": "Viewer" },
      { "ext": ["pdf"], "name": "PDF", "role": "Viewer", "rank": "Alternate" }
    ]
  }
}
