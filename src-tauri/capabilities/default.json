{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for document windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "opener:allow-open-url",
    "dialog:allow-open",
    "clipboard-manager:allow-read-text"
  ]
}
